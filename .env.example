# Copy to .env and adjust. All values are optional - the defaults in docker-compose.yml work
# for a single-host deployment started from the repository directory.

# Host directory that keeps the database and all media. Must be writable by the containers
# (the server image runs as root, so a plain directory is fine).
DATA_DIR=./data

# Published ports
WEB_PORT=8080          # http://<host>:8080  - the browser entry point
SERVER_PORT=8280       # API (bound to 127.0.0.1 only)
RQLITE_PORT=4001       # rqlite HTTP API (bound to 127.0.0.1 only)
TTS_PORT=18180
GEN_VIDEO_PORT=8383
ASR_PORT=10095

# GPU
GPU_RUNTIME=nvidia     # set to "" on a host without an nvidia container runtime (TTS/gen-video will not start)
GPU_IDS=0
SHM_SIZE=8g

# Images (override to use a mirror or a locally loaded tag)
# TTS_IMAGE=guiji2025/fish-speech-ziming:18180
# GEN_VIDEO_IMAGE=guiji2025/duix.avatar:8383
# ASR_IMAGE=guiji2025/fun-asr:10095
# IMAGE_TAG=latest

# Logging and worker
LOG_LEVEL=info         # silent | error | warn | info | debug
WORKER_ENABLED=true
WORKER_INTERVAL_MS=2000
WORKER_LEASE_MS=120000

# RQLITE_LEVEL: none | weak | strong | all
RQLITE_LEVEL=weak

# Optional absolute URL the stack is reachable at (used in generated links/docs only)
PUBLIC_BASE_URL=