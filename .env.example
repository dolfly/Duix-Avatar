# Copy to .env and adjust. Most values are optional - the defaults in docker-compose.yml work
# for a single-host deployment started from the repository directory. EXCEPTION: AUTH_USERNAME
# and AUTH_PASSWORD_HASH (or AUTH_PASSWORD) are required - duix-server refuses to start without them.

# Host directory that keeps the database and all media. Must be writable by the containers
# (the server image runs as root, so a plain directory is fine).
DATA_DIR=./data

# Web login (REQUIRED for the browser deployment).
# duix-server refuses to start without credentials (fail fast). The account/password VALUE
# is chosen by the operator and must never be committed to the repository.
AUTH_USERNAME=
# scrypt password hash, format: scrypt$N$r$p$saltHex$hashHex (N=16384, r=8, p=1, 64-byte key).
# ⚠️ Compose treats `$xxx` as a variable: the hash's `$` separators MUST be written doubled
# (`$$`) in this file. Generate the already-escaped value directly (server/ is type:module):
#   cd server && node -e "import('./src/auth.js').then(m=>console.log(m.hashPassword('YOUR_PASSWORD').split('\$').join('\$\$')))"
AUTH_PASSWORD_HASH=
# Plaintext alternative to AUTH_PASSWORD_HASH (hashed at startup, never stored). Use one or
# the other, not both. Keep empty when AUTH_PASSWORD_HASH is set. Escape any `$` the same way.
#AUTH_PASSWORD=

# Published ports
WEB_PORT=8080          # http://<host>:8080  - the browser entry point
SERVER_PORT=8280       # API (bound to 127.0.0.1 only)
RQLITE_PORT=4001       # rqlite HTTP API (bound to 127.0.0.1 only)
TTS_PORT=18180
GEN_VIDEO_PORT=8383
ASR_PORT=10095

# GPU
# Name of a container runtime that exists on the host. Default nvidia.
# On a host WITHOUT an nvidia runtime do NOT set this to "" (compose would fall back to
# nvidia anyway) - start only the non-GPU services instead:
#   docker compose up -d duix-rqlite duix-server duix-web
# or point it at a runtime that does exist (the GPU containers will then fail on CUDA init,
# which is expected).
GPU_RUNTIME=nvidia
# GPU(s) the GPU services may use. On a multi-GPU host pick the card that supports the
# models (e.g. BF16): the containers run WITHOUT `privileged`, so this filter actually
# applies and prevents CUDA from silently picking a wrong/old card (cudaErrorNoKernelImageForDevice).
# Comma list is accepted by NVIDIA_VISIBLE_DEVICES (e.g. "1" or "0,1").
GPU_IDS=0
# Shared memory for duix-gen-video (PyTorch workers). Default 4g; the host has 24 GiB and
# /dev/shm is a tmpfs, so reserving 8g was excessive. Bump only if gen-video OOMs on /dev/shm.
SHM_SIZE=4g

# Container resource ceilings (DO-120). Bounded so a runaway model can't consume the whole
# 24 GiB / 8 vCPU host and let the kernel OOM-kill toonflow / scenoria / runvm. The defaults
# leave headroom for those other services; tune per host.
GEN_VIDEO_MEM_LIMIT=8g
GEN_VIDEO_CPUS=4
GEN_VIDEO_PIDS_LIMIT=512
TTS_MEM_LIMIT=4g
TTS_CPUS=2
TTS_PIDS_LIMIT=512
ASR_MEM_LIMIT=2g
ASR_CPUS=1
ASR_PIDS_LIMIT=256

# Images. The GPU images default to `latest`, served from this repo's GHCR mirror
# (mirrored from upstream guiji2025/* by .github/workflows/mirror-gpu.yml). Pin them here
# for reproducibility - these version tags exist in the GHCR mirror:
#   TTS_IMAGE=ghcr.io/dolfly/duix-avatar-tts:1.0.43
#   GEN_VIDEO_IMAGE=ghcr.io/dolfly/duix-avatar-gen-video:0.1.0_sdk_slim
#   ASR_IMAGE=ghcr.io/dolfly/duix-avatar-asr:1.0.2
# To pull the upstream tags straight from Docker Hub instead:
#   TTS_IMAGE=guiji2025/fish-speech-ziming:latest
#   GEN_VIDEO_IMAGE=guiji2025/duix.avatar:latest
#   ASR_IMAGE=guiji2025/fun-asr:latest
TTS_IMAGE=ghcr.io/dolfly/duix-avatar-tts:latest
GEN_VIDEO_IMAGE=ghcr.io/dolfly/duix-avatar-gen-video:latest
ASR_IMAGE=ghcr.io/dolfly/duix-avatar-asr:latest
# IMAGE_TAG applies to the locally built web/server images
IMAGE_TAG=latest

# rqlite raft identity. Keep these stable across restarts and rebuilds: the id is written
# into the persisted raft configuration, so changing it breaks the cluster.
RQLITE_NODE_ID=duix-rqlite
RQLITE_HTTP_ADV_ADDR=duix-rqlite:4001
RQLITE_RAFT_ADV_ADDR=duix-rqlite:4002

# Logging and worker
LOG_LEVEL=info         # silent | error | warn | info | debug
WORKER_ENABLED=true
WORKER_INTERVAL_MS=2000
WORKER_LEASE_MS=120000

# GPU inference admission gates (DO-120).
# In-flight cap: how many videos may be inside the GPU pipeline (submitting + pending) at
# once. gen-video is single-process, one thread per submit, on one card - 1 is the safe
# default; concurrent inference would thrash the card.
VIDEO_MAX_INFLIGHT=1
# Hard wall from first claim to a terminal status (TTS + submit + poll), in ms. 30 min is
# generous: TTS is the long pole (minutes). A stuck task is marked failed after this.
VIDEO_TASK_TIMEOUT_MS=1800000
# VRAM admission before submit (fail-closed: cannot determine -> don't submit). duix-server
# needs nvidia-smi (the compose grants it the `utility` GPU capability). Disable only on
# hosts where the probe cannot run - then only VIDEO_MAX_INFLIGHT protects the card.
VIDEO_VRAM_CHECK=true
# Free memory the target card must have before another submit, in MB.
VIDEO_MIN_FREE_VRAM_MB=2048
# nvidia-smi binary path (rarely changed).
NVIDIA_SMI_BIN=nvidia-smi
# Timeout for the nvidia-smi probe subprocess, in ms (keeps admission from blocking the tick).
VIDEO_VRAM_PROBE_TIMEOUT_MS=5000

# RQLITE_LEVEL: none | weak | strong | all
RQLITE_LEVEL=weak

# Optional absolute URL the stack is reachable at (used in generated links/docs only)
PUBLIC_BASE_URL=

# Container-internal paths (advanced; only change if you also change the mounts).
# Path prefix the server sends to the TTS service in `reference_audio`. The TTS image
# prepends its own /code/data, so this must be a leading-slash path relative to that root.
# Default `/` is correct with the default mounts; `/code/data` double-prefixes and breaks
# voice cloning. There is normally no reason to change this.
TTS_REMOTE_DATA_ROOT=/